[
  {
    "name": "2x2 矩阵行列式",
    "latex": "\\det A=ad-bc",
    "expr": "a*d-b*c",
    "category": "linalg",
    "params": [
      {"symbol": "a", "label": "元素 a11", "unit": "", "domain": "", "default": 1},
