    ]
  },
  {
    "name": "2x2 特征方程判别式",
    "latex": "\\Delta=(a+d)^2-4(ad-bc)",
    "expr": "(a+d)^2-4*(a*d-b*c)",
    "category": "linalg",
    "params": [
      {"symbol": "a", "label": "元素 a11", "unit": "", "domain": "", "default": 1},
      {"symbol": "b", "label": "元素 a12", "unit": "", "domain": "", "default": 2},
      {"symbol": "c", "label": "元素 a21", "unit": "", "domain": "", "default": 3},
      {"symbol": "d", "label": "元素 a22", "unit": "", "domain": "", "default": 4}
    ]
  },
  {
    "name": "2x2 较大特征值",
    "latex": "\\lambda_1=\\frac{(a+d)+\\sqrt{(a+d)^2-4(ad-bc)}}{2}",
    "expr": "((a+d)+sqrt((a+d)^2-4*(a*d-b*c)))/2",
    "category": "linalg",
    "params": [
      {"symbol": "a", "label": "元素 a11", "unit": "", "domain": "", "default": 1},
