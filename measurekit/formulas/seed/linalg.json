      {"symbol": "c", "label": "元素 a21", "unit": "", "domain": "", "default": 3},
      {"symbol": "d", "label": "元素 a22", "unit": "", "domain": "", "default": 4}
    ]
  },
  {
    "name": "2x2 逆矩阵（1,1）元素",
    "latex": "A^{-1}_{11}=\\frac{d}{ad-bc}",
    "expr": "d/(a*d-b*c)",
    "category": "linalg",
    "params": [
      {"symbol": "a", "label": "元素 a11", "unit": "", "domain": "", "default": 1},
      {"symbol": "b", "label": "元素 a12", "unit": "", "domain": "", "default": 2},
      {"symbol": "c", "label": "元素 a21", "unit": "", "domain": "", "default": 3},
      {"symbol": "d", "label": "元素 a22", "unit": "", "domain": "ad-bc!=0", "default": 4}
    ]
  },
  {
    "name": "2x2 逆矩阵（1,2）元素",
