      {"symbol": "c", "label": "元素 a21", "unit": "", "domain": "", "default": 3},
      {"symbol": "d", "label": "元素 a22", "unit": "", "domain": "判别式>=0", "default": 4}
    ]
  },
  {
    "name": "2x2 较小特征值",
    "latex": "\\lambda_2=\\frac{(a+d)-\\sqrt{(a+d)^2-4(ad-bc)}}{2}",
    "expr": "((a+d)-sqrt((a+d)^2-4*(a*d-b*c)))/2",
