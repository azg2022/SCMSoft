    ]
  },
  {
    "name": "克拉默法则 x（二元方程组）",
    "latex": "x=\\frac{ed-bf}{ad-bc}",
    "expr": "(e*d-b*f)/(a*d-b*c)",
    "category": "linalg",
    "params": [
      {"symbol": "a", "label": "x 系数（方程 1）", "unit": "", "domain": "", "default": 2},
      {"symbol": "b", "label": "y 系数（方程 1）", "unit": "", "domain": "", "default": 1},
      {"symbol": "c", "label": "x 系数（方程 2）", "unit": "", "domain": "", "default": 1},
      {"symbol": "d", "label": "y 系数（方程 2）", "unit": "", "domain": "ad-bc!=0", "default": 3},
      {"symbol": "e", "label": "常数项（方程 1）", "unit": "", "domain": "", "default": 5},
      {"symbol": "f", "label": "常数项（方程 2）", "unit": "", "domain": "", "default": 6}
    ]
  },
  {
    "name": "克拉默法则 y（二元方程组）",
    "latex": "y=\\frac{af-ec}{ad-bc}",
    "expr": "(a*f-e*c)/(a*d-b*c)",
    "category": "linalg",
    "params": [
      {"symbol": "a", "label": "x 系数（方程 1）", "unit": "", "domain": "", "default": 2},
      {"symbol": "b", "label": "y 系数（方程 1）", "unit": "", "domain": "", "default": 1},
      {"symbol": "c", "label": "x 系数（方程 2）", "unit": "", "domain": "", "default": 1},
      {"symbol": "d", "label": "y 系数（方程 2）", "unit": "", "domain": "ad-bc!=0", "default": 3},
      {"symbol": "e", "label": "常数项（方程 1）", "unit": "", "domain": "", "default": 5},
      {"symbol": "f", "label": "常数项（方程 2）", "unit": "", "domain": "", "default": 6}
    ]
  },
  {
    "name": "3x3 矩阵行列式（按第一行展开）",
