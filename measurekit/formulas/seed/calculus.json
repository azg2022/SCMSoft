    "category": "calculus",
    "params": [
      {"symbol": "yp", "label": "一阶导 y'", "unit": "", "domain": "", "default": 0},
      {"symbol": "ypp", "label": "二阶导 y''", "unit": "", "domain": "ypp!=0", "default": 1}
    ]
  },
  {
    "name": "曲线弧长（常导数近似）",
    "latex": "L\\approx(b-a)\\sqrt{1+y'^2}",
    "expr": "(b-a)*sqrt(1+yp^2)",
    "category": "calculus",
    "params": [
