      {"symbol": "b", "label": "终点", "unit": "", "domain": "b>a", "default": 1},
      {"symbol": "yp", "label": "导数 y'", "unit": "", "domain": "", "default": 1}
    ]
  },
  {
    "name": "一阶泰勒近似",
    "latex": "L(x)=f(x_0)+f'(x_0)(x-x_0)",
    "expr": "f0+yp*(x-x0)",
    "category": "calculus",
    "params": [
