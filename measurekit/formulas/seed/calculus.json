  {
    "name": "梯形法则（单区间积分近似）",
    "latex": "\\int_a^b f(x)dx\\approx\\frac{b-a}{2}[f(a)+f(b)]",
    "expr": "(b-a)/2*(fa+fb)",
    "category": "calculus",
    "params": [
      {"symbol": "a", "label": "左端点", "unit": "", "domain": "", "default": 0},
      {"symbol": "b", "label": "右端点", "unit": "", "domain": "b>a", "default": 1},
      {"symbol": "fa", "label": "f(a)", "unit": "", "domain": "", "default": 1},
      {"symbol": "fb", "label": "f(b)", "unit": "", "domain": "", "default": 2}
    ]
  },
  {
    "name": "辛普森法则（单区间积分近似）",
    "latex": "\\int_a^b f(x)dx\\approx\\frac{b-a}{6}[f(a)+4f(m)+f(b)]",
    "expr": "(b-a)/6*(fa+4*fm+fb)",
    "category": "calculus",
    "params": [
      {"symbol": "a", "label": "左端点", "unit": "", "domain": "", "default": 0},
      {"symbol": "b", "label": "右端点", "unit": "", "domain": "b>a", "default": 2},
      {"symbol": "fa", "label": "f(a)", "unit": "", "domain": "", "default": 1},
      {"symbol": "fm", "label": "f((a+b)/2)", "unit": "", "domain": "", "default": 4},
      {"symbol": "fb", "label": "f(b)", "unit": "", "domain": "", "default": 9}
    ]
  },
  {
    "name": "中点法则（单区间积分近似）",
    "latex": "\\int_a^b f(x)dx\\approx(b-a)f(m)",
    "expr": "(b-a)*fm",
    "category": "calculus",
    "params": [
      {"symbol": "a", "label": "左端点", "unit": "", "domain": "", "default": 0},
      {"symbol": "b", "label": "右端点", "unit": "", "domain": "b>a", "default": 1},
      {"symbol": "fm", "label": "f((a+b)/2)", "unit": "", "domain": "", "default": 1}
    ]
  },
  {
    "name": "平均变化率",
    "latex": "\\frac{\\Delta f}{\\Delta x}=\\frac{f(x_1)-f(x_0)}{x_1-x_0}",
    "expr": "(f1-f0)/(x1-x0)",
    "category": "calculus",
    "params": [
      {"symbol": "x0", "label": "起点 x", "unit": "", "domain": "", "default": 0},
      {"symbol": "x1", "label": "终点 x", "unit": "", "domain": "x1!=x0", "default": 1},
      {"symbol": "f0", "label": "f(x0)", "unit": "", "domain": "", "default": 0},
      {"symbol": "f1", "label": "f(x1)", "unit": "", "domain": "", "default": 2}
    ]
  },
  {
    "name": "中心差分近似导数",
    "latex": "f'(x)\\approx\\frac{f(x+h)-f(x-h)}{2h}",
    "expr": "(fph-fmh)/(2*h)",
    "category": "calculus",
    "params": [
      {"symbol": "h", "label": "步长", "unit": "", "domain": "h>0", "default": 0.01},
      {"symbol": "fph", "label": "f(x+h)", "unit": "", "domain": "", "default": 1.01005},
      {"symbol": "fmh", "label": "f(x-h)", "unit": "", "domain": "", "default": 0.99005}
    ]
  },
  {
    "name": "牛顿-莱布尼茨公式",
    "latex": "\\int_a^b f(x)dx=F(b)-F(a)",
    "expr": "Fb-Fa",
    "category": "calculus",
    "params": [
      {"symbol": "Fa", "label": "原函数 F(a)", "unit": "", "domain": "", "default": 0},
      {"symbol": "Fb", "label": "原函数 F(b)", "unit": "", "domain": "", "default": 1}
    ]
  },
  {
    "name": "曲线曲率半径",
    "latex": "\\rho=\\frac{(1+y'^2)^{3/2}}{|y''|}",
